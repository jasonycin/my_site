---
import Github from './icons8-github.svg';
import LinkedIn from './icons8-linkedin.svg';
import DNA from './dna.png';
import { Image } from 'astro:assets';
---

<div class="m-3 flex md:flex-row md:gap-y-0 gap-y-2 flex-col justify-between">
    <a href="/public" class="logo uppercase font-bold text-4xl tracking-widest">
        <span>Jason LaPierre</span>
    </a>

    <div class="flex flex-row gap-3 -m-1 ">
        <a href="https://www.linkedin.com/in/jason-lapie/" target="_blank">
            <Image src={LinkedIn} alt="LinkedIn" class="w-10 h-10" />
        </a>
        <a href="https://github.com/jasonycin/" target="_blank">
            <Image src={Github} alt="Github" class="w-10 h-10 " />
        </a>
        <a href="https://katarzynatyc.github.io/people/#:~:text=MS%20Students-,Jason%20LaPierre,-%2C%20Spatial%20Microbiome%20Profiling" target="_blank">
            <span class="flex flex-row gap-1 items-center">
                <Image src={DNA} alt="Research" class="w-10 h-10 " />
            </span>

        </a>
    </div>
</div>

