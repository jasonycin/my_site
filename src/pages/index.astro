---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header/Header.astro';
import landingSVG from '../assets/landing_bg.svg';
import AboutMe from '@components/about-me/AboutMe.astro';
---

<Layout>

    <section class="relative min-h-screen overflow-hidden">
        <Header />
        <div class="absolute inset-0 -z-10 bg-cover bg-center bg-no-repeat"
             style={`background-image: url('${landingSVG.src}');`}
        ></div>

        <div class="relative z-10 flex min-h-screen items-center justify-center px-6">
            <div class="text-center">
                <h1 class="text-4xl font-bold text-black">Welcome</h1>
            </div>
        </div>
    </section>

    <section class="relative z-10">
        <AboutMe />
    </section>
</Layout>
