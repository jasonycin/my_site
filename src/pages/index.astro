---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header/Header.astro';
import landingSVG from '../assets/landing_bg.svg';
import AboutMe from '@components/about-me/AboutMe.astro';
import ScrolldownHint from '@components/scrolldown-hint/ScrolldownHint.astro';
---

<Layout>

    <section class="relative max-h-screen overflow-hidden">
        <Header />
        
        <div class="absolute inset-0 -z-10 bg-cover bg-center bg-no-repeat"
             style={`background-image: url('${landingSVG.src}');`}
        ></div>

        <div class="relative z-10 flex min-h-screen items-center justify-center px-6">
            <div class="text-center">
                <h1 class="text-4xl font-bold text-black">Check back later, I'm cleaning out the dust.</h1>
            </div>
        </div>
        
        <div class="absolute bottom-6 left-1/2 z-10 -translate-x-1/2 w-12 h-12 animate-bounce">
            <ScrolldownHint />
        </div>
    </section>

    <section class="relative z-10 hidden">
        <AboutMe />
    </section>
</Layout>
